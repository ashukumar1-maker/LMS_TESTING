# Use Node.js 22 LTS slim image
FROM node:22-slim

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json yarn.lock ./

# Cache downloaded package archives across Docker builds while keeping
# node_modules in the image layer for Compose to seed the container volume.
RUN --mount=type=cache,target=/usr/local/share/.cache/yarn \
    yarn install --frozen-lockfile --non-interactive --cache-folder /usr/local/share/.cache/yarn

# Copy the rest of the application
COPY . .

# Expose port 3000
EXPOSE 3000

# Run the development server with host binding and specific port
CMD ["yarn", "dev", "--host", "--port", "3000"]