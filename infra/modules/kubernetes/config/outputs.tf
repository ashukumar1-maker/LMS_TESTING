output "backend_namespace" {
  description = "Backend Kubernetes namespace."
  value       = kubernetes_namespace_v1.backend.metadata[0].name
}

output "backend_config_map_name" {
  description = "Backend environment ConfigMap name."
  value       = kubernetes_config_map_v1.backend_env.metadata[0].name
}

output "backend_secret_refs_config_map_name" {
  description = "Backend Secret Manager refs ConfigMap name."
  value       = kubernetes_config_map_v1.backend_secret_refs.metadata[0].name
}

output "backend_secret_name" {
  description = "Backend Kubernetes Secret name generated by External Secrets."
  value       = local.backend_secret_name
}

output "backend_gcs_mount_options" {
  description = "GCS Fuse mount options used by backend pods."
  value       = local.gcs_mount_options
}

output "cloud_sql_proxy_image" {
  description = "Cloud SQL Auth Proxy image used by backend pods."
  value       = var.cloud_sql_proxy_image
}

output "backend_deployment_name" {
  description = "Backend Kubernetes Deployment name."
  value       = kubernetes_deployment_v1.backend.metadata[0].name
}

output "backend_container_name" {
  description = "Backend application container name."
  value       = var.container_name
}

output "backend_service_name" {
  description = "Backend Kubernetes Service name."
  value       = kubernetes_service_v1.backend.metadata[0].name
}

output "backend_ingress_name" {
  description = "Backend Kubernetes Ingress name."
  value       = kubernetes_ingress_v1.backend.metadata[0].name
}

output "backend_horizontal_pod_autoscaler_name" {
  description = "Backend HorizontalPodAutoscaler name."
  value       = kubernetes_horizontal_pod_autoscaler_v2.backend.metadata[0].name
}
